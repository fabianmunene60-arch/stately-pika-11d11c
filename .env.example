# Copy this file to .env and add your own private credentials.
# Never put secret keys in public/index.html or commit .env to GitHub.

# Paystack TEST secret key first (sk_test_...). Switch to live only after end-to-end tests.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Provider routing: openai or claude. The selected provider is tried first.
AI_DEFAULT_PROVIDER=openai
# If the first provider fails, try the other configured provider.
AI_FALLBACK_ENABLED=true

# Public HTTPS URL of the deployed Node server, without a trailing slash.
PUBLIC_BASE_URL=https://your-studybuddy-domain.example

# Price per paid assignment in Kenyan shillings.
AMOUNT=50
PORT=3000

# Basic free-tier controls (currently in-memory; reset on server restart).
FREE_QUESTIONS_PER_DAY=5
AI_DAILY_CAP=300

# Optional: use an absolute path on a persistent disk for payment records.
# DATA_FILE=/var/data/studybuddy-payments.json

# Optional persistent account database path (must be on persistent storage in production).
# ACCOUNT_FILE=/var/data/studybuddy-accounts.json
